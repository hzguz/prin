{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "prin",
  "version": "0.1.1",
  "identifier": "com.gustavo.prin",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "prin",
        "width": 960,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0b0f17"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
